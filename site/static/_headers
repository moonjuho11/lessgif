# Cloudflare Pages response headers (other hosts ignore this file). The build fills in the
# Content-Security-Policy that every page also carries in a <meta> tag; frame-ancestors only works
# as a header, and stops other sites from showing these pages inside their own.
/*
  Content-Security-Policy: {{csp}}; frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=3600
